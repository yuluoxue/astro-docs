  	<div id="user-profile" class="greetings">
<script type="text/javascript">
var hello = "";
var hour = new Date().getHours();
// 获取问候语
if (hour < 6) {
    hello = "凌晨好！";
} else if (hour < 9) {
    hello = "早上好！";
} else if (hour < 12) {
    hello = "上午好！";
} else if (hour < 14) {
    hello = "中午好！ ";
} else if (hour < 17) {
    hello = "下午好！ ";
} else if (hour < 19) {
    hello = "傍晚好！";
} else if (hour < 22) {
    hello = "晚上好！ ";
} else {
    hello = "夜深了！ ";
}
document.write(hello);
// 获取日期及星期
var d, s = "";
var x = new Array("星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六");
d = new Date();
s += d.getFullYear() + "年" + (d.getMonth() + 1) + "月" + d.getDate() + "日 ";
s += x[d.getDay()];
document.write(s);
</script>
</div>





