---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from "astro:content";
import { getUpdateStatus } from "../core/system";
import { getPostStatus } from "../core/lifecycle";
import { getPublishedPosts } from "../core/posts";

const pageTitle = "系统首页";

const phase = "结构优化完成";
const status = "稳定运行";
const nextTarget = "内容系统扩展";

/* 读取文章集合 */
const posts = await getPublishedPosts();

/* 过滤草稿 + 排序 */
const publishedPosts = posts
  .filter(post => !post.data.draft)
  .sort((a, b) =>
    b.data.pubDate.getTime() -
    a.data.pubDate.getTime()
  );

/* 最近三篇 */
const recentPosts = publishedPosts.slice(0, 3);

/* 推荐阅读 */
const featuredPosts = publishedPosts
  .filter(post => post.data.featured)
  .slice(0, 3);

/* 最新文章时间 */
const latestPostDate =
  recentPosts.length > 0
    ? recentPosts[0].data.pubDate
    : null;

const lastUpdated = latestPostDate
  ? latestPostDate.toLocaleString("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit"
    })
  : "暂无数据";

/* 系统统计 */
const totalPosts = publishedPosts.length;

const totalTags = new Set(
  publishedPosts.flatMap(p => p.data.tags || [])
).size;

const systemStartDate = new Date("2026-03-01");

const runningDays = Math.floor(
  (Date.now() - systemStartDate.getTime()) /
  (1000 * 60 * 60 * 24)
);
const updateStatus = getUpdateStatus(latestPostDate);
---

<BaseLayout pageTitle={pageTitle}>

<section class="hero">
  <div class="hero-overlay">
    <div id="user-profile" class="greetings"></div>

    <h1>工程技术档案系统</h1>
    <p class="subtitle">
      五年技术升级计划 · 从运行思维走向控制思维
    </p>
  </div>
</section>

<!-- 资源入口 -->
<div class="grid-auto">
  <a href="/resources/dev/" class="resource-card">
    <h3>开发环境</h3>
    <p>Astro · Markdown · 本地构建</p>
  </a>

  <a href="/resources/tools/" class="resource-card">
    <h3>工具链</h3>
    <p>VS Code · Git · 静态部署</p>
  </a>

  <a href="/resources/docs/" class="resource-card">
    <h3>学习来源</h3>
    <p>官方文档 · 技术实践记录</p>
  </a>

  <a href="/resources/lab/" class="resource-card">
    <h3>实验区</h3>
    <p>脚本测试 · 页面结构优化</p>
  </a>
</div>

<!-- 最后同步 -->
<section class="last-sync">
  <div class="sync-box">
    <span class="sync-label">最后同步</span>
    <span class="sync-time">{lastUpdated}</span>

    {updateStatus === "new" && (
      <span class="badge new">NEW</span>
    )}

    {updateStatus === "warn" && (
      <span class="badge warn">180天未更新</span>
    )}

    {updateStatus === "error" && (
      <span class="badge error">时间异常</span>
    )}
  </div>
</section>



<section class="stats-bar">
  <div class="stat-item">
    <span class="stat-value">{totalPosts}</span>
    <span class="stat-label">文章总数</span>
  </div>

  <div class="stat-item">
    <span class="stat-value">{totalTags}</span>
    <span class="stat-label">标签数量</span>
  </div>

  <div class="stat-item">
    <span class="stat-value">{runningDays}</span>
    <span class="stat-label">运行天数</span>
  </div>
</section>

<!-- 最近更新 -->
<section>
  <h2>最近更新</h2>

  <div class="post-grid">
{recentPosts.map(post => {
  const status = getPostStatus(post.data);

  return (
    <article class="post-card">
      <a href={`/posts/${post.slug}/`}>
        <h3 class="post-title">
          {post.data.title}

          {status === "new" && (
            <span class="badge new">新</span>
          )}

          {status === "warn" && (
            <span class="badge warn">注意</span>
          )}

          {status === "expired" && (
            <span class="badge error">过期</span>
          )}
        </h3>

        <p class="post-date">
          {post.data.pubDate.toISOString().split('T')[0]}
        </p>
      </a>
    </article>
  );
})}

  </div>

</section>

<!-- 精选 -->
<section class="featured-section">
  <h2>精选技术档案</h2>

  <div class="grid-auto">
    {featuredPosts.map(post => (
      <article class="post-card">
        <a href={`/posts/${post.slug}/`}>
          <h3 class="post-title">
            {post.data.title}
          </h3>

          <p class="post-desc">
            {post.data.summary ?? "暂无摘要"}
          </p>
        </a>
      </article>
    ))}
  </div>

</section>

</BaseLayout>

<style>

/* 横图区域 */
.hero {
  position: relative;
  height: 420px;
  margin: 40px 0 48px 0;
  border-radius: 16px;

  background:
    linear-gradient(to bottom,
      rgba(0,0,0,0.4),
      rgba(0,0,0,0.6)
    ),
    url('/hero.webp') center/cover no-repeat;
}

/* 仅桌面启用视差 */
@media (min-width: 900px) {
  .hero {
    background-attachment: fixed;
  }
}

.hero-overlay {
  padding: 40px;
  color: #fff;
}

.greetings {
  font-size: 0.95rem;
  opacity: 0.9;
  margin-bottom: 12px;
}

.hero h1 {
  font-size: 2.4rem;
  margin-bottom: 16px;
}

.subtitle {
  font-size: 1.1rem;
  opacity: 0.9;
}

/* 状态行 */



/* 文章列表 */
.post-list {
  display: grid;
  gap: 16px;
  margin-top: 16px;
}


/* 五年计划区 */
.plan {
  margin-top: 60px;
  padding: 24px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 10px;
}

.plan-link {
  display: inline-block;
  margin-top: 12px;
  color: var(--primary);
}
.status-line {
  padding: 12px 0;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}
.hero {
  margin: 30px 0 37px 0;
  border-radius: 16px;
}
.status-value {
  display: flex;
  align-items: center;
  gap: 8px;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 var(--glow);
  }
  70% {
    box-shadow: 0 0 0 8px rgba(0,0,0,0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(0,0,0,0);
  }
}

.featured-section {
  margin-top: 70px;
  padding: 40px;
  background: var(--container-bg);
  border-radius: 16px;
  border: 1px solid var(--border);
}

.featured-grid {
  display: grid;
  gap: 24px;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  margin-top: 20px;
}


.featured-summary {
  margin-top: 8px;
  font-size: 0.9rem;
  color: var(--text-secondary);
}


.label {
  font-size: 0.7rem;
  color: var(--text-secondary);
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.value {
  font-weight: 600;
  font-size: 1rem;
}

@media (max-width: 900px) {
  .stats-bar {
    grid-template-columns: 1fr;
  }
}


section h2 {
  margin-bottom: 20px;
}

.resource-section {
  margin-top: 70px;
   margin-bottom: 40px;
}

.resource-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-top: 20px;
}


.resource-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 24px;
  margin-top: 24px;
}

.resource-card {
  display: block;
  padding: 20px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  text-decoration: none;
  color: var(--text-main);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.resource-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.08);
}
.update-value {
  display: flex;
  align-items: center;
  gap: 8px;
}


.last-sync {
  margin: 40px 0 50px 0;
  display: flex;
  justify-content: center;
}

.sync-box {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 10px 18px;
  border-radius: 999px; /* 胶囊形 */
  background: var(--card-bg);
  border: 1px solid var(--border);
  font-size: 0.85rem;
}

.sync-label {
  color: var(--text-secondary);
}

.sync-time {
  font-weight: 500;
}


</style>

</BaseLayout>
