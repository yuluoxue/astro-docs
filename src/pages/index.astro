---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from "astro:content";
import { getUpdateStatus } from "../core/system";


const pageTitle = "系统首页";

const phase = "结构优化完成";
const status = "稳定运行";
const nextTarget = "内容系统扩展";

/* 读取文章集合 */
const posts = await getCollection("posts");

/* 过滤草稿 + 排序 */
const publishedPosts = posts
  .filter(post => !post.data.draft)
  .sort((a, b) =>
    b.data.pubDate.getTime() -
    a.data.pubDate.getTime()
  );

/* 最近三篇 */
const recentPosts = publishedPosts.slice(0, 3);

/* 推荐阅读 */
const featuredPosts = publishedPosts
  .filter(post => post.data.featured)
  .slice(0, 3);

/* 最新文章时间 */
const latestPostDate =
  recentPosts.length > 0
    ? recentPosts[0].data.pubDate
    : null;

const lastUpdated = latestPostDate
  ? latestPostDate.toLocaleString("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit"
    })
  : "暂无数据";

/* 系统统计 */
const totalPosts = publishedPosts.length;

const totalTags = new Set(
  publishedPosts.flatMap(p => p.data.tags || [])
).size;

const systemStartDate = new Date("2026-02-01");

const runningDays = Math.floor(
  (Date.now() - systemStartDate.getTime()) /
  (1000 * 60 * 60 * 24)
);
const updateStatus = getUpdateStatus(latestPostDate);
---

<BaseLayout pageTitle={pageTitle}>

<section class="hero">
  <div class="hero-overlay">
    <div id="user-profile" class="greetings"></div>

    <h1>工程技术档案系统</h1>
    <p class="subtitle">
      五年技术升级计划 · 从运行思维走向控制思维
    </p>
  </div>
</section>

<!-- 资源入口 -->
<div class="resource-grid">
  <a href="/resources/dev/" class="resource-card">
    <h3>开发环境</h3>
    <p>Astro · Markdown · 本地构建</p>
  </a>

  <a href="/resources/tools/" class="resource-card">
    <h3>工具链</h3>
    <p>VS Code · Git · 静态部署</p>
  </a>

  <a href="/resources/docs/" class="resource-card">
    <h3>学习来源</h3>
    <p>官方文档 · 技术实践记录</p>
  </a>

  <a href="/resources/lab/" class="resource-card">
    <h3>实验区</h3>
    <p>脚本测试 · 页面结构优化</p>
  </a>
</div>

<!-- 状态栏 -->
<section class="status-bar">
<div class="status-item">
  <span class="label">最后同步</span>
  <span class="value update-value">
    {lastUpdated}

    {updateStatus === "new" && (
      <span class="badge new">NEW</span>
    )}

    {updateStatus === "error" && (
      <span class="badge error">时间异常</span>
    )}

    {updateStatus === "warn" && (
      <span class="badge warn">180天未更新</span>
    )}
  </span>
</div>

<!-- 统计 -->
<section class="stats-bar">
  <div class="stat-item">
    <span class="stat-value">{totalPosts}</span>
    <span class="stat-label">文章总数</span>
  </div>

  <div class="stat-item">
    <span class="stat-value">{totalTags}</span>
    <span class="stat-label">标签数量</span>
  </div>

  <div class="stat-item">
    <span class="stat-value">{runningDays}</span>
    <span class="stat-label">运行天数</span>
  </div>
</section>

<!-- 最近更新 -->
<section>
  <h2>最近更新</h2>
  <div class="post-list">
    {recentPosts.map(post => (
      <a href={`/posts/${post.slug}/`} class="post-item">
        <h3>{post.data.title}</h3>
        <p class="meta">
          {post.data.pubDate.toISOString().split('T')[0]}
        </p>
      </a>
    ))}
  </div>
</section>

<!-- 精选 -->
<section class="featured-section">
  <h2>精选技术档案</h2>
  <div class="featured-grid">
    {featuredPosts.map(post => (
      <a href={`/posts/${post.slug}/`} class="featured-item">
        <h3>{post.data.title}</h3>
        <p class="featured-summary">
          {post.data.summary ?? "暂无摘要"}
        </p>
      </a>
    ))}
  </div>
</section>

</BaseLayout>

<style>

/* 横图区域 */
.hero {
  position: relative;
  height: 420px;
  margin: 40px 0 48px 0;
  border-radius: 16px;

  background:
    linear-gradient(to bottom,
      rgba(0,0,0,0.4),
      rgba(0,0,0,0.6)
    ),
    url('/hero.webp') center/cover no-repeat;
}

/* 仅桌面启用视差 */
@media (min-width: 900px) {
  .hero {
    background-attachment: fixed;
  }
}

.hero-overlay {
  padding: 40px;
  color: #fff;
}

.greetings {
  font-size: 0.95rem;
  opacity: 0.9;
  margin-bottom: 12px;
}

.hero h1 {
  font-size: 2.4rem;
  margin-bottom: 16px;
}

.subtitle {
  font-size: 1.1rem;
  opacity: 0.9;
}

/* 状态行 */
.status-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  padding: 24px 0;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}



.status-item .label {
  display: block;
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin-bottom: 6px;
}

.status-item .value {
  font-weight: 600;
  font-size: 1.05rem;
  color: var(--text-main);
}

/* 文章列表 */
.post-list {
  display: grid;
  gap: 16px;
  margin-top: 16px;
}

.post-item {
  padding: 16px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  text-decoration: none;
  color: var(--text-main);
  transition: background 0.2s ease;
}

.post-item:hover {
  background: var(--container-bg);
}

.meta {
  color: var(--text-secondary);
  font-size: 0.9rem;
}

/* 五年计划区 */
.plan {
  margin-top: 60px;
  padding: 24px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 10px;
}

.plan-link {
  display: inline-block;
  margin-top: 12px;
  color: var(--primary);
}
.status-line {
  padding: 12px 0;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}
.hero {
  margin: 30px 0 37px 0;
  border-radius: 16px;
}
.status-value {
  display: flex;
  align-items: center;
  gap: 8px;
}
/*呼吸灯*/
.status-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  animation: pulse 2.2s infinite ease-in-out;
}

/* 正常 */
.status-dot.ok {
  background-color: #22c55e;
  --glow: rgba(34,197,94,0.6);
}

/* 警告 */
.status-dot.warn {
  background-color: #f59e0b;
  --glow: rgba(245,158,11,0.6);
}

/* 错误 */
.status-dot.error {
  background-color: #ef4444;
  --glow: rgba(239,68,68,0.6);
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 var(--glow);
  }
  70% {
    box-shadow: 0 0 0 8px rgba(0,0,0,0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(0,0,0,0);
  }
}
.badge-new {
  margin-left: 8px;
  font-size: 0.65rem;
  padding: 2px 6px;
  border-radius: 3px;

  border: 1px solid var(--primary);
  color: var(--primary);
  background: rgba(0, 0, 0, 0.02);
}

.featured-section {
  margin-top: 70px;
  padding: 40px;
  background: var(--container-bg);
  border-radius: 16px;
  border: 1px solid var(--border);
}

.featured-grid {
  display: grid;
  gap: 24px;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  margin-top: 20px;
}

.featured-item {
  padding: 20px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--container-bg);
  text-decoration: none;
  color: var(--text-main);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.featured-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

.featured-summary {
  margin-top: 8px;
  font-size: 0.9rem;
  color: var(--text-secondary);
}
.status-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  padding: 24px 0;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.status-item {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 16px 20px;
  display: flex;
  flex-direction: column;

  align-self: start;     /* 关键：不要被 grid 拉高 */
}


.label {
  font-size: 0.7rem;
  color: var(--text-secondary);
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.value {
  font-weight: 600;
  font-size: 1rem;
}
@media (max-width: 900px) {
  .status-bar {
    grid-template-columns: 1fr;
  }
}
.status-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 6px;
}

.status-dot.ok {
  background-color: #22c55e;
}

.status-dot.warn {
  background-color: #f59e0b;
}

.status-dot.error {
  background-color: #ef4444;
}
.status-item.warning {
  border-color: #f59e0b;
}

.status-item.warning .value {
  color: #f59e0b;
  font-weight: 600;
}
section h2 {
  margin-bottom: 20px;
}
.post-item {
  transition: transform 0.15s ease;
}

.post-item:hover {
  transform: translateY(-2px);
}
.resource-section {
  margin-top: 70px;
}

.resource-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-top: 20px;
}


.resource-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 24px;
  margin-top: 24px;
}

.resource-card {
  display: block;
  padding: 20px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  text-decoration: none;
  color: var(--text-main);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.resource-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.08);
}
.update-value {
  display: flex;
  align-items: center;
  gap: 8px;
}

.badge {
  padding: 2px 6px;
  font-size: 12px;
  border-radius: 4px;
}

.badge.new {
  background: #22c55e;
  color: white;
}

.badge.warn {
  background: #f59e0b;
  color: white;
}

.badge.error {
  background: #ef4444;
  color: white;
}

</style>

</BaseLayout>
