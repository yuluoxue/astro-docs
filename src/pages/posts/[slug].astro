---
import { getCollection } from "astro:content";
import MarkdownPostLayout from "../../layouts/MarkdownPostLayout.astro";
import { getPublishedPosts } from "../../core/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  const publishedPosts = posts
    .filter(post => !post.data.draft)
    .sort((a, b) =>
      a.data.pubDate.getTime() - b.data.pubDate.getTime()
    );

  return publishedPosts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prev: publishedPosts[index - 1] || null,
      next: publishedPosts[index + 1] || null
    }
  }));
}

const { post, prev, next } = Astro.props;

const { Content, headings } = await post.render();

const h2Headings = headings.filter(h => h.depth === 2);

/* 字数统计 */
const rawContent = post.body || "";
const wordCount = rawContent.length;
const readingTime = Math.max(1, Math.ceil(wordCount / 450));

const allPosts = await getPublishedPosts();

const currentSeries = post.data.series;

let seriesPosts = [];
let currentIndex = -1;

if (currentSeries) {
  seriesPosts = allPosts
    .filter(p => p.data.series === currentSeries)
    .sort((a, b) =>
      (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0)
    );

  currentIndex = seriesPosts.findIndex(
    p => p.slug === post.slug
  );
}
---

<MarkdownPostLayout
  frontmatter={post.data}
  wordCount={wordCount}
  readingTime={readingTime}
  prev={prev}
  next={next}
  headings={h2Headings}
  slug={post.slug}
>
  <Content />
</MarkdownPostLayout>
