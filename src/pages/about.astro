---
import Header from '../components/Header.astro';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
const pageTitle = "关于我们";

const identity = {
  firstName: "蔚洛雪",
  country: "中国大陆地区",
  occupation: "电力生产从事者",
  hobbies: ["新技术", "游戏", ""],
};

const skills = ["前端",  "办公软件","科技", "军事"];

const happy = true;
const finished = true;
const goal = 3;

const skillColor = "purple";


---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		    <title>{pageTitle}</title>

    <style>
      h1 {
        color: purple;
        font-size: 4rem;
      }

:root {
  --skillColor: red;

  }
    .skill {
    color: var(--skillColor);
   font-weight: bold;
 }
    </style>






	</head>
	<body>

    <Header />

    <h1>{pageTitle}</h1>
  <h2>欢迎访问 联邦第六特遣队 网站</h2>

  <p>这是我们的第一个网站。用来提供一些资料</p>

  <p>随着网站更新，我们会提供更多的资料和信息以及服务。</p>
  <p> 联邦第六特遣队负责阻止可能的跨国威胁并切断威胁国家的通道。 威胁包括国际恐怖主义，毒品贩运，外国人走私，大规模毁灭性武器以及威胁联邦安全 部队作战内容除去本土外还存在在海外作战猎杀高价值目标，或联合其他部队一同进攻目标单位。部队拥有海陆空一体化作战能力。 </p>
  
<p>以下是关于我个人的几个事实：</p>
<ul>
  <li>我的名字是{identity.firstName}.</li>
  <li>我住在{identity.country}。我的职业是{identity.occupation}。</li>
  {identity.hobbies.length >= 2 &&
    <li>我的两个爱好：{identity.hobbies[0]}和{identity.hobbies[1]}</li>
  }
</ul>
<p>我的技能是：</p>
<ul>
  {skills.map((skill) => <li class="skill">{skill}</li>)}
</ul>


{happy && <p>为何要建立这个网站！</p>}

{finished && <p>我正在路上！以实践代替学习</p>}

{goal === 3 ? <p>我的目标是在2026年内完成。</p> : <p>我的目标不是 3 天。</p>}

  <Footer />

   <script>
   import "../scripts/menu.js";
 </script>

	</body>
</html>
