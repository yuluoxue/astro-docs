---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "关于系统";

const identity = {
  firstName: "蔚洛雪",
  country: "中国大陆地区",
  occupation: "电力生产从事者",
  hobbies: ["新技术", "游戏"],
};

const skills = ["前端", "办公软件", "科技", "军事"];

const phase = "结构收敛完成";
const status = "稳定运行";
const nextTarget = "内容系统部署";
---

<BaseLayout pageTitle={pageTitle}>

<section class="hero">
  <h1>工程技术档案系统
</h1>
  <p class="subtitle">结构建设中 · 持续迭代 · 长期记录</p>
</section>

<section>
  <h2>系统定位</h2>
  <p>
    本系统用于记录个人在工程技术、系统架构与工具实践中的学习与优化过程。
    所有内容基于实际工作与长期训练整理，强调结构化、可复盘与可迭代。
  </p>
</section>

<section class="status-card">
  <h2>当前阶段</h2>
  <div class="status-content">
    <p><strong>阶段：</strong>{phase}</p>
    <p><strong>状态：</strong>{status}</p>
    <p><strong>下一目标：</strong>{nextTarget}</p>
  </div>
</section>

<section>
  <h2>维护者信息</h2>
  <ul>
    <li>姓名：{identity.firstName}</li>
    <li>地区：{identity.country}</li>
    <li>职业：{identity.occupation}</li>
    {identity.hobbies.length >= 2 &&
      <li>兴趣：{identity.hobbies[0]} / {identity.hobbies[1]}</li>
    }
  </ul>

  <h3>能力领域</h3>
  <ul>
    {skills.map((skill) => <li>{skill}</li>)}
  </ul>
</section>
<style>
.hero {
  margin-top: 48px;
  margin-bottom: 48px;
}

.hero h1 {
  font-size: 2.6rem;
  margin-bottom: 12px;
  color: var(--text-main);
}

.subtitle {
  color: var(--text-secondary);
  font-size: 1rem;
}

section {
  margin-bottom: 48px;
}

/* =========================
   状态卡片（完全变量控制）
   ========================= */

.status-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 24px;
  color: var(--text-main);
}

.status-card h2 {
  margin-top: 0;
}

.status-content p {
  margin: 8px 0;
  color: var(--text-secondary);
}

/* =========================
   模块网格
   ========================= */

.module-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-top: 16px;
}

.module-item {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 20px;
  color: var(--text-main);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.module-item h3 {
  margin-bottom: 8px;
}

.module-item p {
  color: var(--text-secondary);
}

.module-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
}

/* =========================
   列表统一
   ========================= */

ul {
  color: var(--text-main);
}

li {
  margin: 6px 0;
  color: var(--text-secondary);
}
</style>


</BaseLayout>
